# Shared credentials. Postgres uses these, and compose builds the API's DSN from them
POSTGRES_USER=webhook
POSTGRES_PASSWORD=webhook
POSTGRES_DB=webhook_hub

# Host tooling (alembic, pytest run from the venv) reaches the containers on localhost
DATABASE_URL=postgresql+asyncpg://webhook:webhook@localhost:5432/webhook_hub
REDIS_URL=redis://localhost:6379/0

# Tests
TEST_DATABASE_URL=postgresql+asyncpg://webhook:webhook@localhost:5432/webhook_hub_test
